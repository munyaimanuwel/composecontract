<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StackContract.Core\StackContract.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>StackContract.Env</PackageId>
    <RootNamespace>StackContract.Env</RootNamespace>
    <AssemblyName>StackContract.Env</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Manuwel Munyai</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/munyaimanuwel/stackcontract</RepositoryUrl>
    <PackageProjectUrl>https://github.com/munyaimanuwel/stackcontract</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
